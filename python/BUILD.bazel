load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

py_library(
    name = "spatialgl",
    srcs = glob(["spatialgl/*.py"]),
    data = [
        "spatialgl/__init__.pyi",
        "spatialgl/optics.pyi",
        "spatialgl/raster.pyi",
        "spatialgl/viewer.html",
        "//bindings/python:spatialgl/_native",
        "//bindings/python:spatialgl/_optics_native",
        "//bindings/python:spatialgl/_raster_native",
    ],
    imports = ["."],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "demo",
    srcs = ["demo.py"],
    deps = [":spatialgl"],
)

py_binary(
    name = "simulate",
    srcs = ["simulate.py"],
    deps = [":spatialgl"],
)

py_binary(
    name = "optics_scenarios",
    srcs = ["optics_scenarios.py"],
    main = "optics_scenarios.py",
    deps = [
        ":spatialgl",
        "//examples/optics:scenario_lib",
    ],
)

py_test(
    name = "api_test",
    size = "small",
    srcs = ["tests/test_api.py"],
    main = "tests/test_api.py",
    deps = [":spatialgl"],
)

py_test(
    name = "optics_scenario_test",
    size = "small",
    srcs = ["tests/test_optics_scenarios.py"],
    main = "tests/test_optics_scenarios.py",
    deps = [
        ":spatialgl",
        "//examples/optics:scenario_lib",
    ],
)

py_binary(
    name = "python",
    srcs = ["runner.py"],
    main = "runner.py",
    deps = [":spatialgl"],
)

py_test(
    name = "demo_test",
    size = "small",
    srcs = [
        "demo.py",
        "tests/test_demo.py",
    ],
    main = "tests/test_demo.py",
    deps = [":spatialgl"],
)

py_test(
    name = "raster_test",
    size = "small",
    srcs = ["tests/test_raster.py"],
    main = "tests/test_raster.py",
    deps = [
        ":spatialgl",
        "//examples/hardware:raster_demo_lib",
    ],
)
