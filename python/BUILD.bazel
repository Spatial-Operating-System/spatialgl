load("@pybind11_bazel//:build_defs.bzl", "pybind_extension")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_test.bzl", "py_test")

pybind_extension(
    name = "spatialgl/_native",
    srcs = ["bindings.cc"],
    deps = ["//:spatialgl"],
)
py_library(
    name = "spatialgl",
    srcs = glob(["spatialgl/*.py"]),
    data = [":spatialgl/_native", "spatialgl/viewer.html", "spatialgl/__init__.pyi"],
    imports = ["."],
    visibility = ["//visibility:public"],
)
py_binary(
    name = "demo",
    srcs = ["demo.py"],
    deps = [":spatialgl"],
)
py_binary(
    name = "simulate",
    srcs = ["simulate.py"],
    deps = [":spatialgl"],
)
py_test(
    name = "api_test",
    size = "small",
    srcs = ["tests/test_api.py"],
    main = "tests/test_api.py",
    deps = [":spatialgl"],
)

py_binary(
    name = "python",
    srcs = ["runner.py"],
    main = "runner.py",
    deps = [":spatialgl"],
)
py_test(
    name = "demo_test",
    size = "small",
    srcs = ["demo.py", "tests/test_demo.py"],
    main = "tests/test_demo.py",
    deps = [":spatialgl"],
)
